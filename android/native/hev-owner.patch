--- a/src/hev-jni.c
+++ b/src/hev-jni.c
@@ -46,6 +46,8 @@ struct _ThreadData
 static atomic_int is_running;
 static int thread_joinable;
 static JavaVM *java_vm;
+static jclass route_class;
+static jmethodID route_owner_method;
 static pthread_t work_thread;
 static pthread_mutex_t mutex;
 static pthread_key_t current_jni_env;
@@ -87,8 +89,13 @@ JNI_OnLoad (JavaVM *vm, void *reserved)
         return JNI_ERR;
     res = (*env)->RegisterNatives (env, klass, native_methods,
                                    N_ELEMENTS (native_methods));
+    route_owner_method = (*env)->GetStaticMethodID (
+        env, klass, "routeOwnerUid", "(Ljava/lang/String;ILjava/lang/String;I)I");
+    if (!route_owner_method)
+        return JNI_ERR;
+    route_class = (*env)->NewGlobalRef (env, klass);
     (*env)->DeleteLocalRef (env, klass);
-    if (res < 0)
+    if (res < 0 || !route_class)
         return JNI_ERR;
 
     pthread_key_create (&current_jni_env, detach_current_thread);
@@ -97,6 +104,39 @@ JNI_OnLoad (JavaVM *vm, void *reserved)
     return JNI_VERSION_1_4;
 }
 
+int
+hev_route_owner_uid (const char *source, int source_port,
+                     const char *target, int target_port)
+{
+    JNIEnv *env = NULL;
+    jstring local, remote;
+    jint uid = -1;
+    jint res;
+
+    if (!java_vm || !route_class)
+        return -1;
+    res = (*java_vm)->GetEnv (java_vm, (void **)&env, JNI_VERSION_1_4);
+    if (res == JNI_EDETACHED) {
+        if ((*java_vm)->AttachCurrentThread (java_vm, &env, NULL) != JNI_OK)
+            return -1;
+        pthread_setspecific (current_jni_env, env);
+    } else if (res != JNI_OK) {
+        return -1;
+    }
+    local = (*env)->NewStringUTF (env, source);
+    remote = (*env)->NewStringUTF (env, target);
+    if (local && remote)
+        uid = (*env)->CallStaticIntMethod (env, route_class, route_owner_method,
+                                          local, source_port, remote, target_port);
+    if ((*env)->ExceptionCheck (env)) {
+        (*env)->ExceptionClear (env);
+        uid = -1;
+    }
+    if (local) (*env)->DeleteLocalRef (env, local);
+    if (remote) (*env)->DeleteLocalRef (env, remote);
+    return uid;
+}
+
 static void *
 thread_handler (void *data)
 {
